{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LearningAssistant",
  "version": "0.1.0",
  "identifier": "com.learning-assistant.app",
  "build": {
    "beforeDevCommand": "pnpm --filter @la/web run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "pnpm --filter @la/web run build",
    "frontendDist": "../../web/.next/standalone"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "panel",
        "title": "Learning Assistant",
        "url": "http://localhost:3000/panel",
        "width": 380,
        "height": 560,
        "minWidth": 320,
        "minHeight": 400,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "fullscreen": false,
        "visible": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "category": "Productivity",
    "shortDescription": "Capture and learn faster.",
    "longDescription": "Learning Assistant is a floating Mac panel that captures screenshots, voice notes, files, and chat conversations into local learning sessions."
  },
  "plugins": {}
}

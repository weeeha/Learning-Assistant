# Vercel AI Gateway — used for chat (Anthropic Claude) and transcription (OpenAI Whisper).
# Get one at https://vercel.com/dashboard → AI Gateway → API Keys.
AI_GATEWAY_API_KEY=

# Override the chat model if you want to (defaults to anthropic/claude-sonnet-4-6).
# AI_CHAT_MODEL=anthropic/claude-sonnet-4-6

# Override the transcription model (defaults to openai/whisper-1).
# AI_TRANSCRIBE_MODEL=openai/whisper-1

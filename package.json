{
  "name": "learning-assistant",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.32.0",
  "scripts": {
    "dev": "pnpm --filter @la/desktop run tauri dev",
    "dev:web": "pnpm --filter @la/web run dev",
    "dev:tauri": "pnpm --filter @la/desktop run tauri dev",
    "build": "pnpm --filter @la/web run build && pnpm --filter @la/desktop run tauri build",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "db:generate": "pnpm --filter @la/web run db:generate",
    "db:migrate": "pnpm --filter @la/web run db:migrate"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "sharp"
    ]
  }
}
